{
  "languages": {
    "Java": {
      "tab_size": 4,
      "format_on_save": "on",
      "enable_language_server": true,
    },
  },
  "lsp": {
    "jdtls": {
      "settings": {
        "jdk_auto_download": true,
        "lombok_support": true,
      },
      "initialization_options": {
        "settings": {
          "java": {
            "configuration": {
              "runtimes": [
                {
                  "name": "JavaSE-17",
                  "path": "C:/Program Files/Java/jdk-17",
                  "default": true,
                },
              ],
            },
          },
        },
      },
    },
  },
  "terminal": {
    "env": {
      "JAVA_TOOL_OPTIONS": "-Dfile.encoding=UTF-8",
    },
  },
}
